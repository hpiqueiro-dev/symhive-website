---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SimulationVisual from '../components/SimulationVisual.astro';
import { site } from '../config/site';

const challenges = [
  {
    number: '01',
    title: 'A operação muda',
    description: 'Procura, recursos e prioridades alteram-se antes de um plano ficar estável.',
  },
  {
    number: '02',
    title: 'O sistema é interdependente',
    description: 'Uma decisão numa linha, armazém ou frota afeta todo o fluxo.',
  },
  {
    number: '03',
    title: 'O tempo de decisão pesa',
    description: 'Construir e atualizar modelos à mão atrasa a análise de alternativas.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Compreender',
    description: 'Estruturamos dados, processos e restrições do sistema real.',
  },
  {
    number: '02',
    title: 'Modelar',
    description: 'Geramos modelos de simulação com componentes configuráveis e reutilizáveis.',
  },
  {
    number: '03',
    title: 'Explorar',
    description: 'Testamos cenários e organizamos indicadores para comparar decisões.',
  },
];

const applications = [
  { number: '01', title: 'Layout e capacidade', detail: 'Antecipar o impacto de novas configurações.' },
  { number: '02', title: 'Planeamento de produção', detail: 'Avaliar planos perante procura e recursos variáveis.' },
  { number: '03', title: 'Logística interna', detail: 'Dimensionar fluxos, buffers e frotas.' },
  { number: '04', title: 'Novos equipamentos', detail: 'Comparar alternativas antes de investir.' },
];
---

<BaseLayout>
  <SiteHeader />

  <main id="conteudo">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> SIMULAÇÃO · IA · OTIMIZAÇÃO</p>
          <h1 id="hero-title">Da complexidade operacional à <em>decisão informada.</em></h1>
          <p class="hero-description">Criamos modelos de simulação de forma automática para testar cenários e apoiar decisões em produção e logística.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#abordagem">Descobrir a abordagem <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#aplicacoes">Onde aplicamos <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-footnote"><span class="tiny-diamond" aria-hidden="true"></span> Modelos úteis para decisões reais.</div>
        </div>
        <SimulationVisual />
      </div>
      <div class="container hero-bottom" aria-hidden="true">
        <span>SCROLL TO EXPLORE</span><span>01 — 04</span>
      </div>
    </section>

    <section class="signal-strip" aria-label="O que fazemos">
      <div class="container signal-grid">
        <div><span>01 /</span> Modelação automática</div>
        <div><span>02 /</span> Cenários comparáveis</div>
        <div><span>03 /</span> Decisões fundamentadas</div>
      </div>
    </section>

    <section class="section challenge-section" id="desafio" aria-labelledby="challenge-title">
      <div class="container challenge-layout">
        <div class="challenge-intro">
          <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> O DESAFIO</p>
          <h2 id="challenge-title">Decidir com o sistema inteiro em vista.</h2>
          <p>Quando a operação muda, as decisões precisam de mais do que uma fotografia do momento. Precisam de perceber o que acontece a seguir.</p>
          <div class="challenge-mark" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
        <div class="challenge-list">
          {challenges.map((item) => (
            <article class="challenge-item">
              <span class="item-number">{item.number}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <span class="item-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section approach-section" id="abordagem" aria-labelledby="approach-title">
      <div class="container">
        <div class="approach-header">
          <SectionHeading id="approach-title" eyebrow="A ABORDAGEM" title="Menos tempo a construir. Mais tempo a explorar." description="A SymHive combina simulação, inteligência artificial e otimização num fluxo pensado para transformar problemas operacionais em modelos úteis." />
          <p class="approach-side-note">Do sistema real<br />à próxima decisão<span aria-hidden="true">↘</span></p>
        </div>
        <div class="steps" aria-label="Processo SymHive">
          {steps.map((step) => (
            <article class="step-card">
              <div class="step-top"><span>{step.number}</span><span class="step-glyph" aria-hidden="true">✳</span></div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))}
        </div>
        <p class="approach-caption"><span class="caption-dot" aria-hidden="true"></span> Um modelo que evolui com o contexto, em vez de ficar preso a um único estudo.</p>
      </div>
    </section>

    <section class="section applications-section" id="aplicacoes" aria-labelledby="applications-title">
      <div class="container applications-layout">
        <div class="applications-intro">
          <SectionHeading id="applications-title" eyebrow="APLICAÇÕES" title="Simulação onde a operação precisa dela." description="Das decisões estratégicas ao planeamento diário, exploramos alternativas antes de as levar para o terreno." />
          <div class="applications-graphic" aria-hidden="true">
            <span class="graphic-ring graphic-ring-one"></span><span class="graphic-ring graphic-ring-two"></span><span class="graphic-ring graphic-ring-three"></span><span class="graphic-core">S</span>
          </div>
        </div>
        <div class="application-list">
          {applications.map((item) => (
            <article class="application-item">
              <span class="item-number">{item.number}</span>
              <div><h3>{item.title}</h3><p>{item.detail}</p></div>
              <span class="application-plus" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section" id="sobre" aria-labelledby="about-title">
      <div class="container about-layout">
        <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> SOBRE A SYMHIVE</p>
        <div class="about-content">
          <h2 id="about-title">Experiência em simulação.<br /><em>Foco na operação.</em></h2>
          <div class="about-details">
            <p>Somos uma spin-off dedicada à criação automática de modelos de simulação. Transformamos experiência técnica em componentes reutilizáveis para analisar sistemas industriais complexos.</p>
            <div class="about-proof"><span class="proof-icon" aria-hidden="true">✳</span><span>MVP de geração automática validado em casos de uso industriais.</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section" id="contacto" aria-labelledby="contact-title">
      <div class="container contact-layout">
        <div>
          <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> PRÓXIMO PASSO</p>
          <h2 id="contact-title">Há uma decisão complexa em cima da mesa?</h2>
          <p>Vamos perceber como a simulação pode ajudar a explorar as opções.</p>
        </div>
        {site.contactEmail ? (
          <a class="button button-dark" href={`mailto:${site.contactEmail}?subject=Desafio%20de%20simula%C3%A7%C3%A3o%20%E2%80%94%20SymHive`}>Falar com a SymHive <span aria-hidden="true">↗</span></a>
        ) : (
          <span class="contact-pending">Canal de contacto em preparação <span aria-hidden="true">↗</span></span>
        )}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
