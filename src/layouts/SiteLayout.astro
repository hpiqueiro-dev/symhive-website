---
import BaseLayout from './BaseLayout.astro';
import HiveBackground from '../components/HiveBackground.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactSection from '../components/ContactSection.astro';
import { commonContent } from '../i18n/common';
import type { Locale, Page } from '../i18n/locales';

interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
  /** false quando a página fecha com o seu próprio apelo ao contacto (com id 'contact'). */
  contact?: boolean;
  /** Título e texto próprios para a secção de contacto. */
  contactText?: { title: string; description: string };
  /** Versão compacta da secção de contacto (texto à esquerda, botão à direita). */
  contactCompact?: boolean;
  /** Fundo sombreado no contacto, para manter a alternância das secções da página. */
  contactShade?: boolean;
}

const { locale, page, title, description, contact = true, contactText, contactCompact = false, contactShade = false } = Astro.props;
const common = commonContent[locale];
---

<BaseLayout locale={locale} page={page} title={title} description={description}>
  <a class="skip-link" href="#conteudo">{common.skipLink}</a>
  <HiveBackground />
  <SiteHeader locale={locale} page={page} nav={common.nav} demoSubject={common.contact.demo.subject} />
  <main id="conteudo">
    <slot />
    {contact && <ContactSection contact={contactText ? { ...common.contact, ...contactText } : common.contact} compact={contactCompact} shade={contactShade} />}
  </main>
  <SiteFooter locale={locale} nav={common.nav} footer={common.footer} />
</BaseLayout>
