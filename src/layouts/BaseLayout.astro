---
import '../styles/global.css';
import { localeMeta, locales, pagePath, type Locale, type Page } from '../i18n/locales';

interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path);
const canonical = Astro.site ? absolute(Astro.url.pathname) : undefined;
const socialImage = absolute(`${base}images/social-card.png`);
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050b0d" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    {locales.map((code) => <link rel="alternate" hreflang={localeMeta[code].htmlLang} href={absolute(pagePath(code, page))} />)}
    <link rel="icon" type="image/png" href={`${base}images/favicon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
