---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeroSection from '../home/HeroSection.astro';
import PainSection from '../home/PainSection.astro';
import ImpactSection from '../home/ImpactSection.astro';
import SolutionFlow from '../home/SolutionFlow.astro';
import { commonContent } from '../../i18n/common';
import { homeContent } from '../../i18n/home';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = homeContent[locale];
---

<SiteLayout locale={locale} page="home" title={t.meta.title} description={t.meta.description}>
  <HeroSection hero={t.hero} contact={commonContent[locale].contact} />
  <PainSection pain={t.pain} />
  <ImpactSection impact={t.impact} stats={t.stats} />
  <SolutionFlow solution={t.solution} />
</SiteLayout>
