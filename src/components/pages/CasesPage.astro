---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import IndustryIcon from '../IndustryIcon.astro';
import { casesContent, type DecisionType, type IndustryKey } from '../../i18n/cases';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = casesContent[locale];
const industries = Object.entries(t.industries.items) as [IndustryKey, { title: string; description: string }][];
const p = t.problems;
const pad = (n: number) => String(n).padStart(2, '0');
// Problemas agrupados por tipo de decisão, mantendo a numeração global (01–04).
const numbered = p.items.map((problem, i) => ({ ...problem, n: i + 1 }));
const columns: DecisionType[] = ['strategic', 'operational'];
---

<SiteLayout locale={locale} page="cases" title={t.meta.title} description={t.meta.description} contactText={t.contact} contactCompact contactShade>
  <PageHero hero={t.hero} />

  <section class="sec shade" id="industries" aria-labelledby="industries-title">
    <div class="container">
      <h2 class="sec-h2" id="industries-title">{t.industries.title}</h2>
      <ul class="industries">
        {industries.map(([key, item]) => (
          <li><IndustryIcon industry={key} /><h3>{item.title}</h3><p>{item.description}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" id="problems" aria-labelledby="problems-title">
    <div class="container">
      <h2 class="sec-h2" id="problems-title">{p.title}</h2>
      <p class="sec-lead problems-lead">{p.description}</p>
      <div class="problem-columns">
        {columns.map((type) => (
          <div class:list={['problem-col', type]}>
            <div class="decision-head"><h3>{p.decisions[type].title}</h3><p>{p.decisions[type].description}</p></div>
            <div class="problems">
              {numbered.filter((problem) => problem.type === type).map((problem, i) => (
                <details class="problem" open={i === 0}>
                  <summary>
                    <span class="row-n">{pad(problem.n)}</span>
                    <h3>{problem.title}</h3>
                    <span class="problem-desc">{problem.description}</span>
                    <span class="plus" aria-hidden="true"></span>
                  </summary>
                  <div class="problem-cases">
                    {problem.cases.map((item) => (
                      <article class="case">
                        <header>
                          <h4>{item.title}</h4>
                          <span class="tag"><IndustryIcon industry={item.industry} />{t.industries.items[item.industry].title}</span>
                        </header>
                        <dl>
                          <div><dt>{p.labels.challenge}</dt><dd>{item.challenge}</dd></div>
                          <div><dt>{p.labels.approach}</dt><dd>{item.approach}</dd></div>
                          <div><dt>{p.labels.result}</dt><dd class="y">{item.result}</dd></div>
                        </dl>
                      </article>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="ill">{t.note}</p>
    </div>
  </section>
</SiteLayout>
