---
const logo = `${import.meta.env.BASE_URL}images/symhive-logo.png`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="SymHive — início">
      <img src={logo} alt="SymHive" width="193" height="57" />
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href="#abordagem">Abordagem</a>
      <a href="#aplicacoes">Aplicações</a>
      <a href="#sobre">Sobre</a>
    </nav>

    <a class="header-contact" href="#contacto">Falar connosco <span aria-hidden="true">↗</span></a>

    <details class="mobile-nav">
      <summary aria-label="Abrir menu"><span></span><span></span></summary>
      <nav aria-label="Navegação móvel">
        <a href="#abordagem">Abordagem</a>
        <a href="#aplicacoes">Aplicações</a>
        <a href="#sobre">Sobre</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </details>
  </div>
</header>
