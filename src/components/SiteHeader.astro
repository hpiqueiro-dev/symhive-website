---
import { contactHref } from '../config/site';
import { localeMeta, locales, pagePath, type Locale, type Page } from '../i18n/locales';
import type { CommonContent } from '../i18n/common';

interface Props {
  locale: Locale;
  page: Page;
  nav: CommonContent['nav'];
  demoSubject: string;
  /** Destino do botão de demonstração enquanto não houver email configurado. */
  fallbackHref?: string;
}

const { locale, page, nav, demoSubject, fallbackHref = '#contact' } = Astro.props;
const logo = `${import.meta.env.BASE_URL}images/symhive-logo.png`;
const other = locales.find((code) => code !== locale) ?? locale;
const home = pagePath(locale, 'home');
// Submenu «Início»: só as secções da página principal (o logótipo já leva ao topo da página).
const homeLinks = nav.homeSections.map((section) => ({ href: `${home}#${section.id}`, label: section.label, current: false }));
const pageLinks = (['cases', 'product', 'about'] as const).map((key) => ({
  href: pagePath(locale, key),
  label: nav.pages[key],
  current: page === key,
}));
---

<header class="top">
  <div class="container">
    <nav class="nav" aria-label={nav.label}>
      <a class="brand" href={home}><img class="logo" src={logo} alt="SymHive" width="191" height="56" /></a>
      <ul class="nav-links">
        <li>
          <details class="sub" data-close-outside>
            <summary class:list={{ active: page === 'home' }} data-home={home}>{nav.home}<span class="caret" aria-hidden="true"></span></summary>
            <ul>{homeLinks.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}</ul>
          </details>
        </li>
        {pageLinks.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}
      </ul>
      <div class="nav-actions">
        <a class="lang" href={pagePath(other, page)} hreflang={localeMeta[other].htmlLang} lang={localeMeta[other].htmlLang} aria-label={nav.languageLabel}>{localeMeta[other].label}</a>
        <a class="btn amber sm" href={contactHref(demoSubject) ?? fallbackHref}>{nav.cta}</a>
        <details class="menu" data-close-outside>
          <summary aria-label={nav.menu}><span></span><span></span><span></span></summary>
          <div class="menu-panel">
            <p>{nav.home}</p>
            <ul>{homeLinks.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}</ul>
            <ul>{pageLinks.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}</ul>
          </div>
        </details>
      </div>
    </nav>
  </div>
</header>

<script>
  // Fecha os menus ao clicar fora, ao escolher um link ou com Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-close-outside]')];
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      const target = event.target instanceof Node ? event.target : null;
      if (menu.open && (!target || !menu.contains(target) || (target instanceof Element && target.closest('a')))) menu.open = false;
    });
  });
  // Submenu «Início»: em dispositivos com cursor abre ao passar por cima e fecha ao sair.
  // O clique continua a funcionar no teclado (Enter) e em ecrãs táteis.
  const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLDetailsElement>('details.sub').forEach((sub) => {
    let closeTimer = 0;
    sub.addEventListener('mouseenter', () => {
      if (!hoverable.matches) return;
      window.clearTimeout(closeTimer);
      sub.open = true;
    });
    sub.addEventListener('mouseleave', () => {
      if (!hoverable.matches) return;
      closeTimer = window.setTimeout(() => (sub.open = false), 150);
    });
    // Com cursor, o clique do rato em «Início» leva ao topo da página principal (o hover já mostra as opções).
    const summary = sub.querySelector<HTMLElement>('summary');
    summary?.addEventListener('click', (event) => {
      if (!hoverable.matches || event.detail === 0) return;
      event.preventDefault();
      const home = summary.dataset.home ?? '/';
      if (summary.classList.contains('active')) window.scrollTo({ top: 0, behavior: 'smooth' });
      else window.location.href = home;
    });
  });

  // Cabeçalho fixo: ganha fundo depois de sair do topo da página.
  const header = document.querySelector<HTMLElement>('header.top');
  const updateStuck = () => header?.classList.toggle('stuck', window.scrollY > 8);
  window.addEventListener('scroll', updateStuck, { passive: true });
  updateStuck();

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => {
      if (!menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });
</script>
