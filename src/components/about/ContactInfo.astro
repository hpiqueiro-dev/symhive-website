---
import { site } from '../../config/site';
import type { AboutContent, ContactType } from '../../i18n/about';

interface Props {
  contacts: AboutContent['contacts'];
  /** Fundo sombreado, para alternar com as secções vizinhas. */
  shade?: boolean;
}

const { contacts, shade = false } = Astro.props;

// O email vem da configuração do site; os outros valores vêm do conteúdo.
const items = contacts.items.map((item) => {
  const value = item.type === 'email' ? item.value ?? site.contactEmail : item.value;
  const href = !value
    ? undefined
    : item.href ??
      (item.type === 'email' ? `mailto:${value}` : item.type === 'phone' ? `tel:${value.replace(/\s/g, '')}` : item.type === 'linkedin' ? value : undefined);
  return { ...item, value, href };
});

const icons: Record<ContactType, string> = {
  email: 'M4 6h16v12H4zM4 7l8 6 8-6',
  phone: 'M6.6 3.5h3l1.5 4-2 1.3a11 11 0 0 0 5.1 5.1l1.3-2 4 1.5v3A2 2 0 0 1 17.4 18.5 14 14 0 0 1 4.5 5.6 2 2 0 0 1 6.6 3.5z',
  address: 'M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  linkedin: 'M4 4h16v16H4zM8 10v6M8 7.5v.01M11.5 16v-6M11.5 12.5c0-1.5 1-2.5 2.3-2.5 1.4 0 2.2 1 2.2 2.6V16',
};
---

<section class:list={['sec contacts', { shade }]} id="contacts" aria-labelledby="contacts-title">
  <div class="container split">
    <div>
      <h2 class="sec-h2" id="contacts-title">{contacts.title}</h2>
      <p class="sec-lead">{contacts.description}</p>
    </div>
    <ul class="contact-list">
      {items.map((item) => (
        <li>
          <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons[item.type]} /></svg></span>
          <span class="contact-text">
            <small>{item.label}</small>
            {item.value
              ? item.href
                ? <a href={item.href} target={item.type === 'linkedin' ? '_blank' : undefined} rel={item.type === 'linkedin' ? 'noopener' : undefined}>{item.value}</a>
                : <span>{item.value}</span>
              : <span class="pending-value">{contacts.pending}</span>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
