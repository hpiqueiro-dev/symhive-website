---
import KpiRipples from './KpiRipples.astro';
import type { HomeContent } from '../../i18n/home';

interface Props {
  impact: HomeContent['impact'];
  stats: HomeContent['stats'];
}

const { impact, stats } = Astro.props;
const from = impact.manual.weeks;
const to = impact.symhive.weeks;
---

<section class="sec s-impact impact" id="impact" aria-labelledby="impact-title" data-impact data-weeks={impact.weeks} data-from={from} data-to={to}>
  <div class="container">
    <h2 id="impact-title">{impact.title}</h2>
    <div class="brow"><span class="bl">{impact.manual.label}</span><div class="track"><i class="man"></i></div><b class="bv">{from} {impact.weeks}</b></div>
    <div class="brow"><span class="bl">{impact.symhive.label}</span><div class="track"><i class="sym" style={`width:${(to / from) * 100}%`} data-bar></i></div><b class="bv y" data-val>{to} {impact.weeks}</b></div>

    <KpiRipples stats={stats} />
    <p class="src">{impact.source}</p>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // A barra começa nas semanas do processo manual e encolhe até às da SymHive quando entra no ecrã.
  document.querySelectorAll<HTMLElement>('[data-impact]').forEach((section) => {
    const bar = section.querySelector<HTMLElement>('[data-bar]');
    const val = section.querySelector<HTMLElement>('[data-val]');
    const from = Number(section.dataset.from);
    const to = Number(section.dataset.to);
    if (!bar || !val || !from || reduce || !('IntersectionObserver' in window)) return;
    const finalText = val.textContent ?? '';
    const weeks = section.dataset.weeks ?? '';
    const set = (v: number) => {
      bar.style.width = `${(v / from) * 100}%`;
      val.textContent = `${Math.round(v)} ${weeks}`;
    };
    set(from);

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      const delay = 500;
      const duration = 2200;
      let start: number | null = null;
      const step = (ts: number) => {
        start ??= ts;
        const t = ts - start - delay;
        if (t < 0) {
          requestAnimationFrame(step);
          return;
        }
        const p = Math.min(1, t / duration);
        set(from - (from - to) * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(step);
        else val.textContent = finalText;
      };
      requestAnimationFrame(step);
    }, { threshold: 1 });
    observer.observe(bar.parentElement ?? bar);
  });

</script>
