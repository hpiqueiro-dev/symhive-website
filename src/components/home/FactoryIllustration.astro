<style>
  .plant { width: 100%; height: auto; overflow: visible; font-family: var(--font-body, Inter, sans-serif); }
  .floor { fill: rgba(25, 211, 230, .035); stroke: rgba(25, 211, 230, .35); stroke-width: 1; }
  .grid { stroke: rgba(25, 211, 230, .1); stroke-width: 1; }
  .lane { fill: none; stroke: rgba(245, 166, 35, .45); stroke-width: 1.4; stroke-dasharray: 5 6; }
  .box polygon { stroke: rgba(25, 211, 230, .75); stroke-width: 1; stroke-linejoin: round; }
  .ft { fill: #12333a; }
  .fl { fill: #0c2328; }
  .fr { fill: #08191d; }
  .panel .ft { fill: #19d3e6; fill-opacity: .55; }
  .rack .ft { fill: #0e2a30; }
  .shelf { stroke: rgba(25, 211, 230, .6); stroke-width: 1; }
  .crate polygon { stroke: rgba(245, 166, 35, .7); }
  .crate .ft { fill: #5a3f12; } .crate .fl { fill: #3d2b0c; } .crate .fr { fill: #2c1f09; }
  .belt .ft { fill: #0f2c32; }
  .roller { stroke: rgba(25, 211, 230, .35); stroke-width: 1; }
  .robot .ft { fill: #1a3d44; }
  .arm { fill: none; stroke: #e8f1f2; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
  .joint { fill: #050b0d; stroke: #f5a623; stroke-width: 2; }
  .hot polygon { stroke: #f5a623; }
  .hot .ft { fill: #5a3f12; } .hot .fl { fill: #3d2b0c; } .hot .fr { fill: #2c1f09; }
  .part polygon { stroke: rgba(245, 166, 35, .9); }
  .part .ft { fill: #f5a623; } .part .fl { fill: #b87a14; } .part .fr { fill: #8a5a0d; }
  .mover rect { fill: #f5a623; stroke: #050b0d; stroke-width: 1; }
  .agv polygon { stroke: #050b0d; stroke-width: 1; stroke-linejoin: round; }
  .agv .ft { fill: #f5a623; } .agv .fl { fill: #b87a14; } .agv .fr { fill: #8a5a0d; }
  .agv .deck { fill: none; stroke: rgba(5, 11, 13, .55); }
  .agv .wheel { fill: #050b0d; stroke: #9db4b8; stroke-width: .6; }
  .agv .lidar { fill: #19d3e6; stroke: #050b0d; stroke-width: 1; }
  .pulse { fill: none; stroke: #f5a623; stroke-width: 1.5; transform-box: fill-box; transform-origin: center; animation: plant-pulse 2.4s ease-out infinite; }
  @keyframes plant-pulse { from { opacity: .9; transform: scale(.6); } to { opacity: 0; transform: scale(2.4); } }
  .tag rect { fill: rgba(5, 11, 13, .92); stroke: rgba(25, 211, 230, .45); }
  .tag .lead { stroke: rgba(25, 211, 230, .5); stroke-width: 1; }
  .tag .dot { fill: #19d3e6; }
  .tag.hot rect, .tag.hot .lead { stroke: #f5a623; }
  .tag.hot .dot { fill: #f5a623; }
  .t { fill: #9db4b8; font-size: 11px; }
  .v { fill: #e8f1f2; font-size: 12.5px; font-weight: 600; }
  .tag.hot .v { fill: #f5a623; }
  .scenario rect { fill: rgba(5, 11, 13, .92); stroke: rgba(245, 166, 35, .6); }
  .big { fill: #f5a623; font: 700 28px var(--font-display, sans-serif); letter-spacing: -.02em; }
  .up { fill: #3ddc97; }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>

<script>
  // SMIL motion ignores the CSS reduced-motion rule, so pause it explicitly.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('svg.plant').forEach((svg) => svg.pauseAnimations());
  }
</script>
