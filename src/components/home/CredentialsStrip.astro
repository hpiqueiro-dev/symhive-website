---
import type { HomeContent } from '../../i18n/home';

interface Props {
  credentials: HomeContent['credentials'];
}

const { credentials } = Astro.props;
---

<section class="credentials" aria-label={credentials.label}>
  <ul>
    {credentials.items.map((item) => (
      <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5l5.6 3.25v6.5L8 14.5l-5.6-3.25v-6.5z" /></svg>{item}</li>
    ))}
  </ul>
</section>
