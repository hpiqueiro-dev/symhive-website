---
import type { HomeContent } from '../../i18n/home';

interface Props {
  simulator: HomeContent['simulator'];
  /** Fundo sombreado, para alternar com as secções vizinhas. */
  shade?: boolean;
}

const { simulator: s, shade = false } = Astro.props;
const labels = JSON.stringify({
  unitsPerHour: s.unitsPerHour,
  vsToday: s.vsToday,
  station: s.stations.one,
  stations: s.stations.many,
  bottleneckStations: s.bottlenecks.stations,
  bottleneckFleet: s.bottlenecks.fleet,
});
---

<section class:list={['sec', { shade }]} id="sim" aria-labelledby="sim-title">
  <div class="container">
    <div class="sectitle"><h2 id="sim-title">{s.title}</h2><p>{s.description}</p></div>
    <div class="win" data-sim data-labels={labels}>
      <div class="wh"><i></i><i></i><i></i><span>{s.windowTitle}</span><em>{s.live}</em></div>
      <div class="wb">
        <div class="cv">
          <svg viewBox="0 0 720 330" role="img" aria-label={s.canvasLabel}>
            <path class="loop" data-loop d="M80 290H640Q670 290 670 260V70Q670 40 640 40H80Q50 40 50 70V260Q50 290 80 290Z" />
            <path class="lk" d="M170 165H210" /><path class="lk" d="M310 165H350" /><path class="lk" d="M450 165H490" />
            <g class="nd"><rect x="70" y="135" width="100" height="60" rx="10" /><text x="120" y="162">{s.nodes.source[0]}</text><text class="sm" x="120" y="180">{s.nodes.source[1]}</text></g>
            <g class="nd"><rect x="210" y="135" width="100" height="60" rx="10" /><text x="260" y="162">{s.nodes.queue[0]}</text><text class="sm" x="260" y="180">{s.nodes.queue[1]}</text></g>
            <g class="nd" data-proc><rect x="350" y="135" width="100" height="60" rx="10" /><text x="400" y="162">{s.nodes.processor}</text><text class="sm" x="400" y="180" data-o="st">3 {s.stations.many}</text></g>
            <g class="nd"><rect x="490" y="135" width="100" height="60" rx="10" /><text x="540" y="162">{s.nodes.packing[0]}</text><text class="sm" x="540" y="180">{s.nodes.packing[1]}</text></g>
            <defs>
              <g id="sim-agv">
                <rect x="-12" y="-7" width="24" height="14" rx="3" fill="#F5A623" />
                <rect x="-7" y="-3" width="10" height="6" rx="1.5" fill="#412402" fill-opacity=".35" />
                <rect x="8" y="-4.5" width="2.5" height="9" rx="1" fill="#19D3E6" />
                <g fill="#5d7a80"><rect x="-9" y="-9.5" width="6" height="2.5" rx="1" /><rect x="3" y="-9.5" width="6" height="2.5" rx="1" /><rect x="-9" y="7" width="6" height="2.5" rx="1" /><rect x="3" y="7" width="6" height="2.5" rx="1" /></g>
              </g>
            </defs>
            <g data-agvs></g>
          </svg>
        </div>
        <div class="panel">
          <label for="sim-agvs">{s.agvs.label} <b data-o="n">4</b></label>
          <input id="sim-agvs" type="range" data-i="n" min="1" max="10" value="4" aria-label={s.agvs.aria} />
          <label for="sim-stations">{s.stations.label} <b data-o="s">3</b></label>
          <input id="sim-stations" type="range" data-i="s" min="1" max="6" value="3" aria-label={s.stations.aria} />
          <div class="kpi" aria-live="polite"><small>{s.kpis.throughput}</small><b data-o="th"></b><span class="dl" data-o="dl"></span></div>
          <div class="kpi"><small>{s.kpis.utilization}</small><b data-o="ut"></b></div>
          <div class="kpi"><small>{s.kpis.bottleneck}</small><b class="kpi-text" data-o="bn"></b></div>
          <p class="ill">{s.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const LOOP = 'M80 290H640Q670 290 670 260V70Q670 40 640 40H80Q50 40 50 70V260Q50 290 80 290Z';

  interface Labels {
    unitsPerHour: string;
    vsToday: string;
    station: string;
    stations: string;
    bottleneckStations: string;
    bottleneckFleet: string;
  }

  document.querySelectorAll<HTMLElement>('[data-sim]').forEach((root) => {
    const labels = JSON.parse(root.dataset.labels ?? '{}') as Labels;
    const inN = root.querySelector<HTMLInputElement>('[data-i="n"]');
    const inS = root.querySelector<HTMLInputElement>('[data-i="s"]');
    const agvs = root.querySelector<SVGGElement>('[data-agvs]');
    const proc = root.querySelector<SVGGElement>('[data-proc]');
    const loop = root.querySelector<SVGPathElement>('[data-loop]');
    if (!inN || !inS || !agvs || !proc || !loop) return;
    const out = (key: string) => root.querySelector<HTMLElement | SVGElement>(`[data-o="${key}"]`);

    // Modelo ilustrativo: a capacidade da linha é limitada pelos postos ou pela frota de AGVs.
    const update = () => {
      const n = Number(inN.value);
      const s = Number(inS.value);
      const stationCap = s * 190;
      const fleetCap = 640 * (1 - Math.exp(-0.33 * n));
      const throughput = Math.round(Math.pow(Math.pow(stationCap, -3) + Math.pow(fleetCap, -3), -1 / 3));
      const utilization = Math.min(99, Math.round((100 * throughput) / fleetCap));
      const stationsLimit = stationCap < fleetCap;
      const delta = Math.round(((throughput - 320) / 320) * 100);

      const set = (key: string, text: string) => {
        const el = out(key);
        if (el) el.textContent = text;
      };
      const setValue = (key: string, value: number, unit: string) => {
        const el = out(key);
        if (!el) return;
        const u = document.createElement('u');
        u.textContent = unit;
        el.replaceChildren(String(value), u);
      };

      set('n', String(n));
      set('s', String(s));
      setValue('th', throughput, labels.unitsPerHour);
      setValue('ut', utilization, '%');
      set('bn', stationsLimit ? labels.bottleneckStations : labels.bottleneckFleet);
      set('st', `${s} ${s === 1 ? labels.station : labels.stations}`);
      const dl = out('dl');
      if (dl) {
        dl.textContent = `${delta >= 0 ? '+' : ''}${delta}% ${labels.vsToday}`;
        dl.setAttribute('class', `dl ${delta >= 0 ? 'up' : 'dn'}`);
      }
      proc.classList.toggle('hl', stationsLimit);
      loop.classList.toggle('hl', !stationsLimit);

      agvs.replaceChildren();
      for (let i = 0; i < n; i++) {
        // Cada AGV reutiliza o desenho #sim-agv e roda com o percurso (rotate=auto).
        const agv = document.createElementNS(NS, 'use');
        agv.setAttribute('href', '#sim-agv');
        const motion = document.createElementNS(NS, 'animateMotion');
        motion.setAttribute('dur', '14s');
        motion.setAttribute('repeatCount', 'indefinite');
        motion.setAttribute('begin', `-${((i * 14) / n).toFixed(2)}s`);
        motion.setAttribute('path', LOOP);
        motion.setAttribute('rotate', 'auto');
        agv.appendChild(motion);
        agvs.appendChild(agv);
      }
    };

    inN.addEventListener('input', update);
    inS.addEventListener('input', update);
    update();
  });
</script>
