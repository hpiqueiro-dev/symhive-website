---
import FactoryIllustration from './FactoryIllustration.astro';
import type { HomeContent } from '../../i18n/home';

interface Props {
  hero: HomeContent['hero'];
}

const { hero } = Astro.props;
---

<section class="container hero" aria-labelledby="hero-title">
  <div>
    <h1 id="hero-title"><span class="a">{hero.titleAmber}</span> <span class="c">{hero.titleCyan}</span> {hero.titleRest}</h1>
    <p class="lead">{hero.lead}</p>
  </div>
  <FactoryIllustration label={hero.illustrationLabel} />
</section>
