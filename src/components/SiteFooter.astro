---
import { pagePath, pages, type Locale } from '../i18n/locales';
import type { CommonContent } from '../i18n/common';

interface Props {
  locale: Locale;
  nav: CommonContent['nav'];
  footer: CommonContent['footer'];
}

const { locale, nav, footer } = Astro.props;
const logo = `${import.meta.env.BASE_URL}images/symhive-logo.png`;
---

<footer>
  <div class="container">
    <img class="logo" src={logo} alt="SymHive" width="191" height="56" loading="lazy" />
    <nav class="footer-links" aria-label={footer.label}>
      {pages.map((key) => <a href={pagePath(locale, key)}>{nav.pages[key]}</a>)}
    </nav>
    <a class="more-link footer-contact" href={`${pagePath(locale, 'about')}#contacts`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>{footer.contacts}
    </a>
    <span>{footer.poweredBy} <b>{footer.organisation}</b></span>
    <span>{footer.copyright}</span>
  </div>
</footer>
