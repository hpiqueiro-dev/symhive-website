---
import HypothesisPicker from './HypothesisPicker.astro';
import '../styles/final-prototypes.css';
interface Props { concept: 'leitura-clara' | 'centro-comando' }
const { concept } = Astro.props;
const base = import.meta.env.BASE_URL;
const monitor = `${base}illustrations/console-symhive.svg`;
const title = concept === 'leitura-clara' ? 'Leitura clara' : 'Centro de comando';
---
<!doctype html>
<html lang="pt-PT">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><meta name="description" content={`Proposta final ${title} para a SymHive.`}/><title>{title} — proposta final SymHive</title></head>
  <body class={`final-page final-${concept}`}>
    <a class="final-skip" href="#conteudo">Saltar para o conteúdo</a>
    {concept === 'leitura-clara' && <>
      <header class="fa-header final-shell"><a class="final-brand" href="#inicio" aria-label="SymHive, voltar ao início"><span>⬡</span> SymHive</a><nav aria-label="Navegação principal"><a href="#explorar">Explorar</a><a href="#metodo">Método</a><a href="#aplicacoes">Aplicações</a></nav><a class="fa-header-contact" href="#contacto">Falar connosco <span aria-hidden="true">↗</span></a></header>
      <main id="conteudo">
        <section class="fa-hero final-shell" id="inicio"><div class="fa-hero-copy"><p class="final-eyebrow"><i></i> Simulação para decisões industriais</p><h1>O próximo passo começa com uma hipótese.</h1><p>Da operação real a cenários comparáveis. Geramos modelos de simulação para perceber o impacto de cada escolha antes de a levar para o terreno.</p><div class="fa-actions"><a class="fa-button" href="#explorar">Explorar uma hipótese <span aria-hidden="true">↗</span></a><a href="#metodo">Como funciona</a></div></div><div class="fa-monitor-wrap"><div class="final-monitor"><div class="final-monitor-top"><span>SYMHIVE / LEITURA DE SISTEMA</span><span><i></i> MODELO ATIVO</span></div><img src={monitor} alt="Gráfico animado de trajetórias de simulação" width="900" height="640"/><div class="final-monitor-bottom"><span>Trajetória atual</span><span>Alternativa simulada</span></div></div><span class="fa-monitor-caption">Vista ilustrativa de cenários operacionais</span></div></section>
        <div class="fa-rail"><div class="final-shell"><span>Compreender a operação</span><span>Testar alternativas</span><span>Decidir com evidência</span></div></div>
        <section class="fa-explore final-shell" id="explorar"><div class="fa-explore-copy"><p class="final-section-label">Experimente a pergunta</p><h2>Uma escolha muda o sistema inteiro.</h2><p>O primeiro passo é definir a hipótese. Depois, o modelo permite comparar os seus efeitos no fluxo, nos recursos e na capacidade.</p><small>Exemplo ilustrativo · sem dados operacionais reais</small></div><HypothesisPicker /></section>
        <section class="fa-method" id="metodo"><div class="final-shell fa-method-grid"><div><p class="final-section-label">O método SymHive</p><h2>Uma leitura rigorosa, do início ao fim.</h2></div><div class="fa-method-steps"><article><span>01</span><div><h3>Compreender</h3><p>Organizamos dados, processos e restrições do sistema real.</p></div></article><article><span>02</span><div><h3>Modelar</h3><p>Geramos componentes de simulação configuráveis e reutilizáveis.</p></div></article><article><span>03</span><div><h3>Explorar</h3><p>Testamos cenários com os mesmos critérios e organizamos indicadores para decidir.</p></div></article></div></div></section>
        <section class="fa-apps final-shell" id="aplicacoes"><div><p class="final-section-label">Aplicações</p><h2>Onde a simulação faz diferença.</h2></div><ul><li><span>Layout e capacidade</span><small>Antecipar novas configurações.</small></li><li><span>Planeamento de produção</span><small>Explorar planos perante procura variável.</small></li><li><span>Logística interna</span><small>Dimensionar fluxos, buffers e frotas.</small></li><li><span>Novos equipamentos</span><small>Comparar alternativas antes de investir.</small></li></ul></section>
        <section class="fa-contact" id="contacto"><div class="final-shell"><p class="final-section-label">Próximo passo</p><h2>Que decisão precisa de ser testada?</h2><span>Canal de contacto público em preparação.</span></div></section>
      </main><footer class="fa-footer final-shell"><span>⬡ SymHive</span><span>Proposta final A · Leitura clara</span></footer>
    </>}
    {concept === 'centro-comando' && <>
      <header class="fb-header final-shell"><a class="final-brand" href="#inicio" aria-label="SymHive, voltar ao início"><span>⬡</span> SymHive</a><nav aria-label="Navegação principal"><a href="#explorar">Cenários</a><a href="#abordagem">Abordagem</a><a href="#aplicacoes">Aplicações</a></nav><a href="#contacto">Falar connosco <span aria-hidden="true">↗</span></a></header>
      <main id="conteudo">
        <section class="fb-hero" id="inicio"><div class="final-shell fb-hero-grid"><div class="fb-hero-copy"><p class="fb-kicker"><i></i> Inteligência para operações complexas</p><h1>Ver a operação antes de a mudar.</h1><p>Modelos de simulação que revelam como uma decisão se propaga pela produção e pela logística.</p><a class="fb-button" href="#explorar">Explorar cenários <span aria-hidden="true">↗</span></a></div><div class="fb-hero-visual"><div class="fb-orbit fb-orbit-one"></div><div class="fb-orbit fb-orbit-two"></div><div class="final-monitor"><div class="final-monitor-top"><span>SYMHIVE / SIMULATION SYSTEM</span><span><i></i> EM MODELO</span></div><img src={monitor} alt="Gráfico animado de duas trajetórias de uma operação simulada" width="900" height="640"/><div class="final-monitor-bottom"><span>Operação</span><span>Possibilidade</span></div></div></div><div class="fb-hero-foot"><span>Dados → Modelo → Cenários → Decisão</span><span>Descer ↓</span></div></div></section>
        <section class="fb-statement"><div class="final-shell"><p>Uma pergunta pode mudar o plano.</p><h2>Mais tempo a compreender. Menos tempo a adivinhar.</h2></div></section>
        <section class="fb-explore final-shell" id="explorar"><HypothesisPicker /><div class="fb-explore-copy"><p class="final-section-label">Comece por uma hipótese</p><h2>Teste antes de tocar no sistema real.</h2><p>Escolha uma alteração. O modelo ajuda a observar os seus efeitos em toda a operação e a comparar caminhos com os mesmos critérios.</p><small>Exemplo ilustrativo · sem dados operacionais reais</small></div></section>
        <section class="fb-approach" id="abordagem"><div class="final-shell"><div class="fb-approach-head"><p class="final-section-label">Abordagem</p><h2>Da complexidade a opções que a equipa consegue discutir.</h2></div><div class="fb-approach-grid"><article><span>Dados e contexto</span><p>Compreender processos, recursos e restrições da operação.</p></article><article><span>Modelo configurável</span><p>Representar relações com componentes que podem evoluir.</p></article><article><span>Cenários comparáveis</span><p>Ver as consequências das alternativas antes de agir.</p></article></div></div></section>
        <section class="fb-apps final-shell" id="aplicacoes"><p class="final-section-label">Onde aplicar</p><h2>Uma tecnologia. Muitas decisões.</h2><div><span>Produção</span><span>Layout e capacidade</span><span>Logística interna</span><span>Novos equipamentos</span></div></section>
        <section class="fb-contact" id="contacto"><div class="final-shell"><p class="final-section-label">Próximo passo</p><h2>Traga o desafio. Exploramos as possibilidades.</h2><span>Canal de contacto público em preparação.</span></div></section>
      </main><footer class="fb-footer final-shell"><span>⬡ SymHive</span><span>Proposta final B · Centro de comando</span></footer>
    </>}
    <nav class="final-switcher" aria-label="Alternar entre propostas finais"><a href={`${base}prototipos/finais/`}>Comparar</a><a href={`${base}prototipos/finais/leitura-clara/`} aria-current={concept === 'leitura-clara' ? 'page' : undefined}>A</a><a href={`${base}prototipos/finais/centro-comando/`} aria-current={concept === 'centro-comando' ? 'page' : undefined}>B</a></nav>
  </body>
</html>
