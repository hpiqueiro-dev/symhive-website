---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
  <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>
