---
import '../styles/new-prototypes.css';
interface Props { concept: 'horizonte' | 'oficina' | 'console' | 'camadas' }
const { concept } = Astro.props;
const base = import.meta.env.BASE_URL;
const names = { horizonte: 'Horizonte', oficina: 'Oficina', console: 'Console', camadas: 'Camadas' };
const choices = [ ['horizonte','05'], ['oficina','06'], ['console','07'], ['camadas','08'] ];
const illustration = (name: string) => `${base}illustrations/${name}.svg`;
---
<!doctype html>
<html lang="pt-PT">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><meta name="description" content={`Protótipo ${names[concept]} para a página da SymHive.`}/><title>{names[concept]} — protótipo SymHive</title></head>
  <body class={`np-page np-${concept}`}>
    <a class="np-skip" href="#conteudo">Saltar para o conteúdo</a>
    {concept === 'horizonte' && <>
      <header class="hz-header np-shell"><a class="np-wordmark" href="#inicio"><span>⬡</span> SymHive</a><nav aria-label="Navegação principal"><a href="#possibilidades">Possibilidades</a><a href="#metodo">Método</a><a href="#contacto">Contacto</a></nav><a class="hz-header-link" href="#possibilidades">Explorar <span aria-hidden="true">↗</span></a></header>
      <main id="conteudo">
        <section class="hz-hero" id="inicio"><div class="np-shell hz-hero-copy"><p class="hz-small">Modelos de simulação para produção e logística</p><h1>O futuro de uma operação não tem de ser uma surpresa.</h1><p>Antes de escolher uma direção, explore as que são possíveis. A SymHive transforma processos reais em modelos para testar cenários e apoiar decisões.</p><a href="#possibilidades">Ver o que podemos explorar <span aria-hidden="true">↓</span></a></div><div class="hz-art-wrap"><img src={illustration('horizon')} alt="Paisagem animada de trajetórias e cenários possíveis" width="1200" height="620"/><div class="hz-art-note np-shell"><span>Operação atual</span><span>Caminhos possíveis</span></div></div></section>
        <section class="hz-possibilities np-shell" id="possibilidades"><div class="hz-section-intro"><span>Explorar antes de agir</span><h2>Cada cenário abre uma perspetiva diferente.</h2></div><div class="hz-options"><article><span class="hz-option-symbol">↗</span><h3>Mais capacidade?</h3><p>Observe como uma alteração de recursos pode influenciar o fluxo inteiro.</p></article><article><span class="hz-option-symbol">〰</span><h3>Outro percurso?</h3><p>Compare disposições e movimentos antes de alterar o layout.</p></article><article><span class="hz-option-symbol">◎</span><h3>Um novo plano?</h3><p>Teste alternativas perante procura, turnos e prioridades variáveis.</p></article></div></section>
        <section class="hz-method" id="metodo"><div class="np-shell hz-method-grid"><p>Como chegamos lá</p><div><h2>Uma simulação que acompanha a pergunta.</h2><p>Compreendemos dados e restrições, geramos um modelo configurável e organizamos indicadores para que cada hipótese seja comparável.</p><div class="hz-method-tags"><span>Compreender</span><span>Modelar</span><span>Explorar</span></div></div></div></section>
        <section class="hz-contact np-shell" id="contacto"><h2>Qual é a próxima decisão?</h2><p>O canal de contacto público está em preparação.</p></section>
      </main><footer class="hz-footer np-shell"><span>⬡ SymHive</span><span>Protótipo 05 · Horizonte</span></footer>
    </>}
    {concept === 'oficina' && <>
      <header class="wk-header np-shell"><a class="np-wordmark" href="#inicio"><span>⬡</span> SymHive</a><nav aria-label="Navegação principal"><a href="#o-que-fazemos">O que fazemos</a><a href="#processo">Processo</a><a href="#contacto">Contacto</a></nav><span>Simulação / indústria</span></header>
      <main id="conteudo"><section class="wk-hero" id="inicio"><div class="np-shell"><div class="wk-hero-top"><span>Problemas reais. Hipóteses testáveis.</span><span>SymHive ©</span></div><div class="wk-hero-title"><h1>PÔR AS<br/>HIPÓTESES<br/>A TRABALHAR.</h1><p>Modelos de simulação gerados para experimentar mudanças antes de mexer na operação.</p></div><div class="wk-art"><img src={illustration('workshop')} alt="Ilustração animada de peças a atravessar uma linha de produção" width="900" height="580"/></div><div class="wk-hero-bottom"><a href="#o-que-fazemos">Abrir a oficina <span aria-hidden="true">↘</span></a><span>Produção · Logística · Capacidade</span></div></div></section>
        <section class="wk-work np-shell" id="o-que-fazemos"><div class="wk-work-title"><span>O que fazemos</span><h2>Antes da mudança, um ensaio.</h2></div><div class="wk-work-list"><article><strong>01</strong><div><h3>Desenhar o sistema</h3><p>Mapeamos dados, recursos e restrições da operação real.</p></div></article><article><strong>02</strong><div><h3>Montar o modelo</h3><p>Criamos componentes de simulação configuráveis e reutilizáveis.</p></div></article><article><strong>03</strong><div><h3>Testar a hipótese</h3><p>Comparamos cenários e os seus efeitos antes de decidir.</p></div></article></div></section>
        <section class="wk-stamp" id="processo"><div class="np-shell"><p>Layout. Capacidade. Produção. Logística interna.</p><h2>UM SISTEMA.<br/>VÁRIAS FORMAS<br/>DE O MELHORAR.</h2></div></section>
        <section class="wk-contact np-shell" id="contacto"><span>Próximo ensaio</span><h2>Que hipótese vale a pena testar?</h2><p>Canal de contacto público em preparação.</p></section>
      </main><footer class="wk-footer np-shell"><span>⬡ SymHive</span><span>Protótipo 06 · Oficina</span></footer>
    </>}
    {concept === 'console' && <>
      <header class="cs-header np-shell"><a class="np-wordmark" href="#inicio"><span>⬡</span> SymHive</a><nav aria-label="Navegação principal"><a href="#leitura">Leitura</a><a href="#modelo">Modelo</a><a href="#contacto">Contacto</a></nav><span class="cs-status"><i></i> Exploração ativa</span></header>
      <main id="conteudo"><section class="cs-hero np-shell" id="inicio"><div class="cs-intro"><p class="cs-prompt">SYMHIVE / SIMULATION SYSTEM</p><h1>O sistema fala. É preciso saber ouvi-lo<span class="cs-cursor">_</span></h1><p>Uma leitura mais clara da complexidade operacional. Modelos de simulação para comparar decisões em produção e logística.</p><a href="#leitura">Entrar na análise <span aria-hidden="true">↗</span></a></div><div class="cs-monitor"><div class="cs-monitor-top"><span>VISUALIZAÇÃO / CENÁRIO A</span><span>● EM MODELO</span></div><img src={illustration('console')} alt="Gráfico animado com duas trajetórias de simulação" width="900" height="640"/><div class="cs-monitor-foot"><span>Trajetória atual</span><span>Alternativa simulada</span></div></div></section>
        <section class="cs-ticker" aria-label="Capacidades"><div>MAPEAR PROCESSOS <span>✳</span> GERAR MODELOS <span>✳</span> COMPARAR CENÁRIOS <span>✳</span> DECIDIR COM EVIDÊNCIA <span>✳</span></div></section>
        <section class="cs-read np-shell" id="leitura"><div><span class="cs-prompt">LEITURA / 01</span><h2>Ver além do indicador isolado.</h2></div><div class="cs-read-body"><p>Uma decisão numa linha, armazém ou frota afeta o resto do sistema. A simulação ajuda a tornar visíveis essas relações.</p><ul><li><span>→</span> Identificar restrições</li><li><span>→</span> Explorar alternativas</li><li><span>→</span> Comparar efeitos</li></ul></div></section>
        <section class="cs-model" id="modelo"><div class="np-shell"><span class="cs-prompt">MÉTODO / 02</span><h2>DADOS + CONTEXTO<br/>→ MODELO<br/>→ DECISÃO</h2><p>Componentes reutilizáveis permitem atualizar o modelo quando a operação muda.</p></div></section>
        <section class="cs-contact np-shell" id="contacto"><span class="cs-prompt">PRÓXIMO COMANDO</span><h2>Que sistema quer compreender melhor?</h2><p>Canal de contacto público em preparação.</p></section>
      </main><footer class="cs-footer np-shell"><span>⬡ SymHive</span><span>Protótipo 07 · Console</span></footer>
    </>}
    {concept === 'camadas' && <>
      <header class="ly-header np-shell"><a class="np-wordmark" href="#inicio"><span>⬡</span> SymHive</a><nav aria-label="Navegação principal"><a href="#camadas">As camadas</a><a href="#aplicacoes">Aplicações</a><a href="#contacto">Contacto</a></nav><a href="#camadas">Explorar <span aria-hidden="true">↗</span></a></header>
      <main id="conteudo"><section class="ly-hero" id="inicio"><div class="np-shell ly-hero-grid"><div class="ly-copy"><p>Simulação para entender o todo</p><h1>Uma decisão tem muitas camadas.</h1><p>Dados, restrições, pessoas e fluxos interagem. A SymHive junta estas perspetivas num modelo que ajuda a testar antes de mudar.</p><a href="#camadas">Ver o que revelam <span aria-hidden="true">↓</span></a></div><div class="ly-art"><img src={illustration('layers')} alt="Três planos animados de dados, modelo e cenários sobrepostos" width="850" height="670"/></div></div><div class="ly-hero-caption np-shell"><span>Dados</span><span>Modelo</span><span>Cenários</span><span>Decisão</span></div></section>
        <section class="ly-layers np-shell" id="camadas"><div class="ly-layers-heading"><span>A leitura completa</span><h2>Olhar por partes. Decidir com o todo.</h2></div><div class="ly-layer-list"><details open><summary><span>01</span> A operação que existe <b aria-hidden="true">+</b></summary><p>Processos, recursos e restrições dão forma ao sistema real.</p></details><details><summary><span>02</span> O modelo que a representa <b aria-hidden="true">+</b></summary><p>Componentes configuráveis permitem reproduzir relações e testar alterações.</p></details><details><summary><span>03</span> Os cenários que se abrem <b aria-hidden="true">+</b></summary><p>Alternativas comparáveis revelam efeitos antes de qualquer mudança no terreno.</p></details></div></section>
        <section class="ly-uses" id="aplicacoes"><div class="np-shell"><span>Aplicações</span><h2>Do layout à logística, cada escolha altera outra coisa.</h2><div><span>Capacidade</span><span>Planeamento</span><span>Fluxos internos</span><span>Equipamentos</span></div></div></section>
        <section class="ly-contact np-shell" id="contacto"><p>Há uma decisão por explorar?</p><h2>Vamos olhar para todas as camadas.</h2><span>Canal de contacto público em preparação.</span></section>
      </main><footer class="ly-footer np-shell"><span>⬡ SymHive</span><span>Protótipo 08 · Camadas</span></footer>
    </>}
    <nav class="np-switcher" aria-label="Alternar entre novos protótipos"><a href={`${base}prototipos/novos/`}>Ver os 4</a>{choices.map(([slug, number]) => <a href={`${base}prototipos/novos/${slug}/`} aria-current={concept === slug ? 'page' : undefined} aria-label={`Protótipo ${number}: ${names[slug as keyof typeof names]}`}>{number}</a>)}</nav>
  </body>
</html>
