---
import { contactHref } from '../config/site';
import type { CommonContent } from '../i18n/common';

interface Props {
  contact: CommonContent['contact'];
  /** Sem email configurado: `link` aponta para a secção de contacto, `pending` mostra o aviso. */
  fallback: 'link' | 'pending';
  /** Mostra só o botão do piloto, como botão principal. */
  pilotOnly?: boolean;
}

const { contact, fallback, pilotOnly = false } = Astro.props;
const demo = contactHref(contact.demo.subject);
const pilot = contactHref(contact.pilot.subject);
---

{pilotOnly && (pilot || fallback === 'link') ? (
  <div class="ctas">
    <a class="btn amber" href={pilot ?? '#contact'}>{contact.pilot.label}</a>
  </div>
) : demo && pilot ? (
  <div class="ctas">
    <a class="btn amber" href={demo}>{contact.demo.label}</a>
    <a class="btn ghost" href={pilot}>{contact.pilot.label}</a>
  </div>
) : fallback === 'link' ? (
  <div class="ctas">
    <a class="btn amber" href="#contact">{contact.demo.label}</a>
    <a class="btn ghost" href="#contact">{contact.pilot.label}</a>
  </div>
) : (
  <div class="ctas"><span class="pending">{contact.pending}</span></div>
)}
