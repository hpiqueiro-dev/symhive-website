---
import type { ProductContent } from '../../i18n/product';

interface Props {
  features: ProductContent['features'];
  /** Fundo sombreado, para alternar com as secções vizinhas. */
  shade?: boolean;
}

const { features, shade = false } = Astro.props;
---

<section class:list={['sec', { shade }]} id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="sectitle"><h2 id="features-title">{features.title}</h2><p>{features.description}</p></div>
    <ul class="features">
      {features.items.map((item, i) => (
        <li class="feature">
          <div class="feature-top">
            <span class="feature-hex" aria-hidden="true"><span></span></span>
            <span class="feature-meta">
              {item.tag && <span class="feature-tag">{item.tag}</span>}
              <span class="feature-n">{String(i + 1).padStart(2, '0')}</span>
            </span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class:list={['feature-status', item.status]}><i></i>{features.statusLabels[item.status]}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
