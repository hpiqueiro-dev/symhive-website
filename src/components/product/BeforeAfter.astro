---
import type { ProductContent } from '../../i18n/product';

interface Props {
  beforeAfter: ProductContent['beforeAfter'];
  /** Fundo sombreado, para alternar com as secções vizinhas. */
  shade?: boolean;
}

const { beforeAfter: t, shade = false } = Astro.props;
---

<section class:list={['sec', { shade }]} id="before-after" aria-labelledby="ba-title">
  <div class="container">
    <div class="sectitle"><h2 id="ba-title">{t.title}</h2><p>{t.description}</p></div>
    <div class="ba">
      <div class="ba-card before">
        <h3>{t.before.label}</h3>
        <ul>
          {t.before.items.map((item) => (
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>{item}</li>
          ))}
        </ul>
      </div>
      <svg class="ba-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
      <div class="ba-card after">
        <h3>{t.after.label}</h3>
        <ul>
          {t.after.items.map((item) => (
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.8 2.8L16 9.8" /></svg>{item}</li>
          ))}
        </ul>
      </div>
    </div>
    <p class="ill ba-note">{t.note}</p>
  </div>
</section>
